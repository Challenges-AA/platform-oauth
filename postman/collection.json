{
  "info": {"name":"Portage OAuth E2E","description":"Tests de bout en bout : vérifie d'abord le refus sans jeton, demande ensuite un jeton au grant personnalisé, appelle la ressource protégée avec ce Bearer et confirme qu'un sujet utilisateur incohérent est refusé. Nécessite les variables client_secret, username, password et subject dans l'environnement Postman. Les scripts de test enregistrent le jeton dans _access_token le temps de l'exécution.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"as","value":"http://127.0.0.1:9000"},{"key":"rs","value":"http://127.0.0.1:9001"}],
  "item": [
    {"name":"No token is rejected","request":{"method":"GET","url":"{{rs}}/hello"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('unauthenticated request returns 401',()=>pm.response.to.have.status(401));"]}}]},
    {"name":"Issue token and access resource","item":[
      {"name":"Issue token","request":{"method":"POST","auth":{"type":"basic","basic":[{"key":"username","value":"demo-client","type":"string"},{"key":"password","value":"{{client_secret}}","type":"string"}]},"header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"grant_type","value":"urn:portage:params:oauth:grant-type:subject"},{"key":"username","value":"{{username}}"},{"key":"password","value":"{{password}}"},{"key":"subject","value":"{{subject}}"},{"key":"scope","value":"hello.read"}]},"url":"{{as}}/oauth2/token"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('token issued',()=>pm.response.to.have.status(200));","const body=pm.response.json();","pm.expect(body.access_token).to.be.a('string').and.not.empty;","pm.environment.set('_access_token',body.access_token);"]}}]},
      {"name":"Call protected resource","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{_access_token}}","type":"string"}]},"url":"{{rs}}/hello"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('resource accepted token',()=>pm.response.to.have.status(200));","pm.test('expected response',()=>pm.expect(pm.response.json().message).to.eql('HelloWorld'));"]}}]},
      {"name":"Mismatched subject denied","request":{"method":"POST","auth":{"type":"basic","basic":[{"key":"username","value":"demo-client","type":"string"},{"key":"password","value":"{{client_secret}}","type":"string"}]},"header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"grant_type","value":"urn:portage:params:oauth:grant-type:subject"},{"key":"username","value":"{{username}}"},{"key":"password","value":"{{password}}"},{"key":"subject","value":"subject-2"},{"key":"scope","value":"hello.read"}]},"url":"{{as}}/oauth2/token"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('mismatched subject denied',()=>pm.expect(pm.response.code).to.be.oneOf([400,401]));"]}}]}
    ]}
  ],
  "event":[{"listen":"afterIteration","script":{"type":"text/javascript","exec":["pm.environment.unset('_access_token');"]}}]
}
