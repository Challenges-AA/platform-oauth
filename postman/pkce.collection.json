          "name": "03 Authorize PKCE S256",
          "request": {
            "method": "GET",
            "url": "{{as}}/oauth2/authorize?response_type=code&client_id={{client_id}}&redirect_uri={{redirect_uri}}&scope=hello.read&state={{_state}}&code_challenge={{_challenge}}&code_challenge_method=S256",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
