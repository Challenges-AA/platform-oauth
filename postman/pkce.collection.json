                ]
              }
            }
          ]
        },
        {
          "name": "Exchange fresh authorization code",
          "request": {
            "method": "POST",
            "url": "{{as}}/oauth2/token",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "code",
                  "value": "{{authorization_code}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirect_uri}}"
                },
                {
                  "key": "code_verifier",
                  "value": "{{code_verifier}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PKCE exchange succeeds', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const b = pm.response.json(); pm.test('short-lived bearer and refresh token', () => { pm.expect(b.token_type.toLowerCase()).to.eql('bearer'); pm.expect(b.expires_in).to.be.within(298,300); pm.expect(b.refresh_token).to.be.a('string').and.not.empty; }); pm.variables.set('_first_refresh', b.refresh_token); }",
                  "if(pm.response.code===200)pm.variables.set('_access_token',pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "15 Explicitly revoke fresh refresh token",
          "request": {
            "method": "POST",
            "url": "{{as}}/oauth2/revoke",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "token",
                  "value": "{{_first_refresh}}"
                },
                {
                  "key": "token_type_hint",
                  "value": "refresh_token"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('revocation succeeds',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "16 Explicitly revoked refresh is rejected",
          "request": {
            "method": "POST",
            "url": "{{as}}/oauth2/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "refresh_token",
                  "value": "{{_first_refresh}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('revoked refresh rejected',()=>{pm.response.to.have.status(400);pm.expect(pm.response.json().error).to.eql('invalid_grant');});"
                ]
              }
            }
          ]
        }
      ]
    },
